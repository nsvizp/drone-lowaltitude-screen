// SQLite 单文件数据库 — 应急指挥调度平台后端
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  // 相对 schema 文件的 SQLite 路径（免环境变量，clone 即可运行）
  url      = "file:../data/app.db"
}

// ---------- 配置中心（高德 key 等） ----------
model SystemConfig {
  key         String   @id
  value       String
  isSecret    Boolean  @default(false) @map("is_secret")
  description String   @default("")
  updatedAt   DateTime @updatedAt @map("updated_at")
  updatedBy   String   @default("system") @map("updated_by")

  @@map("system_config")
}

// ---------- 认证 ----------
model User {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  passwordHash String   @map("password_hash")
  displayName  String   @map("display_name")
  role         String   @default("admin")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("users")
}

model LoginAttempt {
  id        Int      @id @default(autoincrement())
  username  String
  success   Boolean
  ip        String   @default("")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([username, createdAt])
  @@map("login_attempts")
}

// ---------- 飞行记录（接口2 数据源） ----------
model FlightRecord {
  id          Int    @id
  name        String
  routeId     Int    @map("route_id")
  routeName   String @map("route_name")
  flyerId     Int    @map("flyer_id")
  flyerName   String @map("flyer_name")
  shelterId   Int    @map("shelter_id")
  shelterName String @map("shelter_name")
  createTime  String @map("create_time")

  @@map("flight_records")
}

// ---------- 台账 ----------
model Warehouse {
  id       Int    @id
  name     String @unique
  org      String
  items    String
  stock    Int
  capacity Int
  lng      Float  @default(0)
  lat      Float  @default(0)

  @@map("warehouses")
}

model Shelter {
  id          Int    @id
  name        String
  lng         Float
  lat         Float
  spareDrones Int    @map("spare_drones")

  @@map("shelters")
}

model Flyer {
  id          Int    @id
  name        String
  lastMission String @map("last_mission")

  @@map("flyers")
}

// ---------- 聚合快照（接口1/3/4/5 数据源；真实业务接入后替换为实时聚合） ----------
model StatFeed {
  key       String   @id
  payload   String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("stat_feeds")
}

// ---------- M3：事件流 / 节点 / 灾情档案 ----------
model EventFeed {
  id        Int      @id @default(autoincrement())
  kind      String
  text      String
  createdAt DateTime @default(now()) @map("created_at")

  @@map("event_feed")
}

model NodeRecord {
  id         Int      @id @default(autoincrement())
  disasterId Int?     @map("disaster_id")
  title      String
  detail     String
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("node_records")
}

model DisasterEvent {
  id         Int       @id @default(autoincrement())
  severity   Int
  lng        Float
  lat        Float
  createdAt  DateTime  @default(now()) @map("created_at")
  resolvedAt DateTime? @map("resolved_at")

  @@map("disaster_events")
}

// SQLite 单文件数据库 — 应急指挥调度平台后端
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  // 相对 schema 文件的 SQLite 路径（免环境变量，clone 即可运行）
  url      = "file:../data/app.db"
}

// ---------- 配置中心（高德 key 等） ----------
model SystemConfig {
  key         String   @id
  value       String
  isSecret    Boolean  @default(false) @map("is_secret")
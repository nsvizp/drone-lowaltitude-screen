// SQLite 单文件数据库 — 应急指挥调度平台后端
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------- 配置中心（高德 key 等） ----------
model SystemConfig {
  key         String   @id
  value       String
  isSecret    Boolean  @default(false) @map("is_secret")
  description String   @default("")
  updatedAt   DateTime @updatedAt @map("updated_at")
  updatedBy   String   @default("system") @map("updated_by")

  @@map("system_config")
}

// ---------- 认证 ----------
model User {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  passwordHash String   @map("password_hash")
  displayName  String   @map("display_name")
  role         String   @default("admin")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("users")
}

model LoginAttempt {
  id        Int      @id @default(autoincrement())
  username  String
  success   Boolean
  ip        String   @default("")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([username, createdAt])
  @@map("login_attempts")
}
// ---------- 飞行记录（接口2 数据源） ----------
model FlightRecord {
  id          Int    @id
  name        String
  routeId     Int    @map("route_id")
  routeName   String @map("route_name")
  flyerId     Int    @map("flyer_id")
  flyerName   String @map("flyer_name")
  shelterId   Int    @map("shelter_id")
  shelterName String @map("shelter_name")
  createTime  String @map("create_time")

  @@map("flight_records")
}

// ---------- 台账 ----------
model Warehouse {
  id       Int    @id
  name     String @unique
  org      String
  items    String
  stock    Int
  capacity Int

  @@map("warehouses")
}

model Shelter {
  id          Int    @id
  name        String
  lng         Float
  lat         Float
  spareDrones Int    @map("spare_drones")

  @@map("shelters")
}

model Flyer {
  id          Int    @id
  name        String
  lastMission String @map("last_mission")

  @@map("flyers")
}

// ---------- 聚合快照（接口1/3/4/5 数据源；真实业务接入后替换为实时聚合） ----------
model StatFeed {
  key       String   @id
  payload   String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("stat_feeds")
}
